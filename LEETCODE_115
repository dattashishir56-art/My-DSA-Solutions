class Solution {
public:
    int st(string s, string t,int i,int j,vector<vector<int>>& dp){
        if(j==t.size()) return 1;
        if(i==s.size()) return 0;
        if(dp[i][j]!=-1) return dp[i][j];
        if(s[i]==t[j]) return dp[i][j]=st(s,t,i+1,j+1,dp) +st(s,t,i+1,j,dp);
        else return dp[i][j]=st(s,t,i+1,j,dp);
    }
    int numDistinct(string s, string t) {
        if(s.size()<t.size()) return 0;
        vector<vector<int>>dp(s.size()+5,vector<int>(t.size()+5,-1));
        return st(s,t,0,0,dp);
    }
};