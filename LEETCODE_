class Solution {
public:
bool st(string &s,string &p,int i,int j,vector<vector<int>>& dp){
    if (j == p.size()) return i == s.size();
        if (i == s.size()) {                 // only '*' can match empty
            for (int k = j; k < p.size(); k++)
                if (p[k] != '*') return false;
            return true;
        }
        if (dp[i][j] != -1) return dp[i][j];

        if (p[j] == '*')
            // '*' matches empty  ||  '*' consumes one char
            return dp[i][j] = st(s, p, i, j + 1, dp) || st(s, p, i + 1, j, dp);

        if (p[j] == '?' || p[j] == s[i])
            return dp[i][j] = st(s, p, i + 1, j + 1, dp);

        return dp[i][j] = false;

}
    bool isMatch(string s, string p) {
  
       
        vector<vector<int>>dp(s.size()+5,vector<int>(p.size()+5,-1));
        return st(s,p,0,0,dp);
    }
};